# Sao chép file này thành .env rồi điền MỘT trong hai API key.
# Để trống cả hai thì app chạy ở chế độ DEMO (kết quả mẫu, không gọi AI).

# Google Gemini – có hạn mức miễn phí. Lấy key tại https://aistudio.google.com/apikey
# Lưu ý: dữ liệu gửi qua gói miễn phí có thể được Google dùng để cải thiện sản phẩm.
GEMINI_API_KEY=
# Mô hình Gemini (không bắt buộc). Mặc định: gemini-3.6-flash
GEMINI_MODEL=

# Anthropic Claude – trả phí. Lấy key tại https://console.anthropic.com
# Điền cả hai key: app dùng Claude trước, Claude lỗi (hết tiền, quá tải…) thì tự chuyển sang Gemini.
ANTHROPIC_API_KEY=
# Mô hình Claude (không bắt buộc): claude-haiku-5-5 (mặc định) | claude-sonnet-5-5 | claude-opus-5-5
CLAUDE_MODEL=

# Cổng chạy web (mặc định 3000)
PORT=3000
